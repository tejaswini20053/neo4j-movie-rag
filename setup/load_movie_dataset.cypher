CREATE (NoraE)-[:WROTE]->(SleeplessInSeattle)
CREATE (NoraE)-[:WROTE]->(YouveGotMail)
CREATE (OliverStone)-[:WROTE]->(JFK)

// REVIEWED (critics reviewing movies)
CREATE (JeffR)-[:REVIEWED {summary:'An excellent thriller with philosophical depth', rating:95}]->(TheMatrix)
CREATE (Critic1)-[:REVIEWED {summary:'A solid romantic comedy', rating:80}]->(YouveGotMail)
CREATE (Critic1)-[:REVIEWED {summary:'Heartfelt and funny', rating:85}]->(SleeplessInSeattle)
CREATE (Critic2)-[:REVIEWED {summary:'Ambitious but uneven', rating:70}]->(CloudAtlas)
CREATE (Critic1)-[:REVIEWED {summary:'A stylish, well-paced adaptation', rating:65}]->(TheDaVinciCode)

// FOLLOWS (social edge between critics, adds graph variety)
CREATE (Critic1)-[:FOLLOWS]->(Critic2)
CREATE (Critic2)-[:FOLLOWS]->(JeffR)
